{
  "name": "gpt-live-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "knowledge:storage": "azurite-blob --blobHost 127.0.0.1 --location .knowledge-tmp/azurite --silent --skipApiVersionCheck",
    "knowledge:worker": "tsx server/knowledge/worker.ts",
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts server/knowledge/worker.ts --bundle --platform=node --packages=external --format=esm --outbase=server --outdir=dist/server",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:scene:live": "tsx scripts/scene-smoke.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "azurite": "^3.37.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
