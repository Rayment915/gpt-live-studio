AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_DEPLOYMENT=gpt-live-1
RESPONSES_DEPLOYMENT=gpt-6-luna
# Comma-separated allowed deployments; use your Azure deployment aliases.
RESPONSES_DEPLOYMENTS=gpt-6-luna,gpt-live-dev-sol
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
MAX_SESSIONS=4
MAX_SESSION_SECONDS=1800
AUTH_MODE=local

# Local knowledge worker: npm run knowledge:storage for Azurite.
# Real Azure Blob: leave connection string empty; set URL and use az login.
KNOWLEDGE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
KNOWLEDGE_STORAGE_URL=https://your-dev-storage.blob.core.windows.net
KNOWLEDGE_CONTAINER=gpt-live-dev
KNOWLEDGE_SEARCH_ENDPOINT=https://your-dev-search.search.windows.net
KNOWLEDGE_SEARCH_KEY=
KNOWLEDGE_INDEX_PREFIX=gpt-live-dev
KNOWLEDGE_OCR_ENDPOINT=https://your-dev-ocr.cognitiveservices.azure.com
KNOWLEDGE_OCR_KEY=
KNOWLEDGE_EMBEDDING_ENDPOINT=https://your-singapore-foundry.openai.azure.com
KNOWLEDGE_EMBEDDING_DEPLOYMENT=gpt-live-dev-embedding
KNOWLEDGE_EMBEDDING_KEY=
# Optional absolute LibreOffice binary path; otherwise uses soffice on PATH.
# KNOWLEDGE_SOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice
