{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": { "value": "gpt-live-studio" },
    "location": { "value": "southeastasia" },
    "environmentName": { "value": "REPLACE_EXISTING_ENVIRONMENT" },
    "image": { "value": "REPLACE_PULLABLE_IMAGE_REFERENCE" },
    "acrLoginServer": { "value": "REPLACE_ACR_LOGIN_SERVER" },
    "pullIdentityId": { "value": "REPLACE_ACR_PULL_IDENTITY_RESOURCE_ID" },
    "foundryEndpoint": { "value": "https://your-resource.openai.azure.com" },
    "responsesDeployment": { "value": "gpt-6-luna" },
    "externalIngress": { "value": false },
    "foundryApiKey": { "reference": { "keyVault": { "id": "REPLACE_KEY_VAULT_RESOURCE_ID" }, "secretName": "foundry-api-key" } },
    "adminPasswordHash": { "reference": { "keyVault": { "id": "REPLACE_KEY_VAULT_RESOURCE_ID" }, "secretName": "admin-password-hash" } }
  }
